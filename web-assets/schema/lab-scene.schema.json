{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Faibot M1 phòng lab v2 (sinh bởi sim/lab/build_lab.py, cùng nguồn với sim/lab/lab.xml)",
 "description": "Hai tầng: (1) khoá phẳng theo hợp đồng check:m1-assets của web: seed, table, fridge.door.joint, cabinet.drawers[2], box.lid.joint + box.lid.start, trays[] (màu và shape khác nhau), objects[] (vật kẹp được, có tray, inside), tasks.pick_place.k; (2) items[]: cây link/geom hình khối của mọi đồ để dựng lại đúng như MJCF. max_triangles: ngân sách tam giác khi web dựng cảnh bằng hình khối.",
 "type": "object",
 "required": [
  "schema",
  "seed",
  "units",
  "robot",
  "table",
  "palette",
  "fridge",
  "cabinet",
  "box",
  "trays",
  "objects",
  "tasks",
  "items",
  "max_triangles"
 ],
 "properties": {
  "schema": {
   "type": "string",
   "pattern": "^faibot-m1-lab-scene/"
  },
  "generator": {
   "type": "string"
  },
  "mjcf": {
   "type": "string"
  },
  "units": {
   "type": "object",
   "required": [
    "length",
    "angle"
   ],
   "properties": {
    "length": {
     "const": "m"
    },
    "angle": {
     "const": "rad"
    }
   }
  },
  "robot": {
   "type": "object",
   "required": [
    "mjcf",
    "start"
   ],
   "properties": {
    "start": {
     "$ref": "#/$defs/vec3"
    }
   }
  },
  "table": {
   "type": "object",
   "required": [
    "height",
    "edge_x",
    "depth",
    "y_range",
    "size",
    "position"
   ]
  },
  "palette": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/hex"
   }
  },
  "objects": {
   "type": "array",
   "minItems": 6,
   "maxItems": 10,
   "items": {
    "$ref": "#/$defs/object"
   }
  },
  "seed": {
   "type": "integer"
  },
  "fridge": {
   "type": "object",
   "required": [
    "size",
    "position",
    "door"
   ],
   "properties": {
    "size": {
     "$ref": "#/$defs/vec3"
    },
    "position": {
     "$ref": "#/$defs/vec3"
    },
    "door": {
     "type": "object",
     "required": [
      "joint",
      "hinge",
      "handle"
     ],
     "properties": {
      "joint": {
       "$ref": "#/$defs/joint"
      },
      "hinge": {
       "$ref": "#/$defs/vec3"
      },
      "handle": {
       "$ref": "#/$defs/vec3"
      }
     }
    }
   }
  },
  "cabinet": {
   "type": "object",
   "required": [
    "size",
    "position",
    "drawers"
   ],
   "properties": {
    "size": {
     "$ref": "#/$defs/vec3"
    },
    "position": {
     "$ref": "#/$defs/vec3"
    },
    "drawers": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "type": "object",
      "required": [
       "joint",
       "handle"
      ],
      "properties": {
       "joint": {
        "$ref": "#/$defs/joint"
       },
       "handle": {
        "$ref": "#/$defs/vec3"
       }
      }
     }
    }
   }
  },
  "box": {
   "type": "object",
   "required": [
    "size",
    "position",
    "lid"
   ],
   "properties": {
    "size": {
     "$ref": "#/$defs/vec3"
    },
    "position": {
     "$ref": "#/$defs/vec3"
    },
    "lid": {
     "type": "object",
     "required": [
      "joint",
      "start",
      "hinge",
      "knob"
     ],
     "properties": {
      "joint": {
       "$ref": "#/$defs/joint"
      },
      "hinge": {
       "$ref": "#/$defs/vec3"
      },
      "knob": {
       "$ref": "#/$defs/vec3"
      },
      "start": {
       "type": "number",
       "description": "góc nắp lúc đầu (rad), trong joint.range; MJCF qpos0 = ref = start; 0 = đóng"
      }
     }
    }
   }
  },
  "trays": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "object",
    "required": [
     "id",
     "color",
     "label",
     "shape",
     "size",
     "position"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "color": {
      "$ref": "#/$defs/hex"
     },
     "label": {
      "type": "string"
     },
     "shape": {
      "enum": [
       "tron",
       "vuong",
       "tam_giac"
      ],
      "description": "hình ký hiệu của ngăn (đáy và nhãn mặt trước); các khay không trùng hình (S5)"
     },
     "size": {
      "$ref": "#/$defs/vec3"
     },
     "position": {
      "$ref": "#/$defs/vec3"
     },
     "shape_label": {
      "type": "string"
     }
    }
   }
  },
  "tasks": {
   "type": "object",
   "required": [
    "pick_place",
    "sorting",
    "open_close"
   ],
   "properties": {
    "pick_place": {
     "type": "object",
     "required": [
      "k",
      "objects",
      "target",
      "done_when"
     ],
     "properties": {
      "k": {
       "const": 3
      },
      "objects": {
       "type": "array",
       "minItems": 3,
       "maxItems": 3
      }
     }
    },
    "sorting": {
     "type": "object",
     "required": [
      "objects",
      "done_when"
     ]
    },
    "open_close": {
     "type": "object",
     "required": [
      "targets",
      "done_when"
     ]
    }
   }
  },
  "items": {
   "type": "array",
   "minItems": 10,
   "items": {
    "$ref": "#/$defs/item"
   }
  },
  "max_triangles": {
   "type": "integer",
   "minimum": 1,
   "description": "ngân sách tam giác cho cảnh lab dựng bằng hình khối (không tính robot)"
  },
  "budget": {
   "type": "object",
   "required": [
    "max_triangles",
    "triangles_est"
   ],
   "properties": {
    "max_triangles": {
     "type": "integer",
     "minimum": 1
    },
    "triangles_est": {
     "type": "integer",
     "minimum": 0
    },
    "assume": {
     "type": "string"
    }
   }
  }
 },
 "$defs": {
  "vec3": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 3,
   "maxItems": 3
  },
  "hex": {
   "type": "string",
   "pattern": "^#[0-9a-f]{6}$"
  },
  "link": {
   "type": "object",
   "required": [
    "name",
    "parent",
    "pos",
    "joint",
    "geoms"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "parent": {
     "type": [
      "string",
      "null"
     ]
    },
    "pos": {
     "$ref": "#/$defs/vec3"
    },
    "yaw": {
     "type": "number"
    },
    "joint": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/joint"
      }
     ]
    },
    "handle": {
     "$ref": "#/$defs/vec3"
    },
    "knob": {
     "$ref": "#/$defs/vec3"
    },
    "geoms": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/geom"
     }
    }
   }
  },
  "joint": {
   "type": "object",
   "required": [
    "type"
   ],
   "properties": {
    "type": {
     "enum": [
      "hinge",
      "slide",
      "free"
     ]
    },
    "name": {
     "type": "string"
    },
    "axis": {
     "$ref": "#/$defs/vec3"
    },
    "range": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "open_min": {
     "type": "number"
    },
    "closed_max": {
     "type": "number"
    },
    "damping": {
     "type": "number"
    },
    "frictionloss": {
     "type": "number"
    },
    "start": {
     "type": "number",
     "description": "trạng thái lúc đầu (rad hoặc m), MJCF ref = qpos0"
    }
   },
   "if": {
    "properties": {
     "type": {
      "enum": [
       "hinge",
       "slide"
      ]
     }
    }
   },
   "then": {
    "required": [
     "name",
     "axis",
     "range",
     "open_min",
     "closed_max",
     "start"
    ]
   }
  },
  "geom": {
   "type": "object",
   "required": [
    "shape",
    "size",
    "pos",
    "color",
    "collide"
   ],
   "properties": {
    "shape": {
     "enum": [
      "box",
      "cylinder",
      "sphere"
     ]
    },
    "size": {
     "type": "array",
     "items": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "minItems": 1,
     "maxItems": 3
    },
    "pos": {
     "$ref": "#/$defs/vec3"
    },
    "euler": {
     "$ref": "#/$defs/vec3"
    },
    "color": {
     "$ref": "#/$defs/hex"
    },
    "collide": {
     "type": "boolean"
    },
    "mass": {
     "type": "number"
    }
   }
  },
  "item": {
   "type": "object",
   "required": [
    "id",
    "name",
    "type",
    "label",
    "pos",
    "links"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "type": {
     "enum": [
      "room",
      "furniture",
      "zone",
      "fixture",
      "articulated",
      "object"
     ]
    },
    "label": {
     "type": "string"
    },
    "pos": {
     "$ref": "#/$defs/vec3"
    },
    "color_class": {
     "enum": [
      "red",
      "green",
      "blue"
     ]
    },
    "shape": {
     "enum": [
      "box",
      "cylinder",
      "sphere"
     ]
    },
    "radius": {
     "type": "number"
    },
    "cells": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "color_class",
       "center",
       "size"
      ]
     }
    },
    "links": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/link"
     }
    }
   }
  },
  "object": {
   "type": "object",
   "required": [
    "id",
    "color",
    "shape",
    "size",
    "position",
    "tray"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "label": {
     "type": "string"
    },
    "color": {
     "$ref": "#/$defs/hex"
    },
    "color_class": {
     "enum": [
      "red",
      "green",
      "blue"
     ]
    },
    "shape": {
     "enum": [
      "box",
      "cylinder",
      "sphere"
     ]
    },
    "size": {
     "$ref": "#/$defs/vec3"
    },
    "position": {
     "$ref": "#/$defs/vec3"
    },
    "yaw": {
     "type": "number"
    },
    "mass": {
     "type": "number"
    },
    "tray": {
     "type": "string"
    },
    "inside": {
     "enum": [
      "fridge",
      "cabinet",
      "box"
     ]
    }
   }
  }
 }
}
